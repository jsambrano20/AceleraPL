@model IEnumerable<Vendedor.Models.HistPedido>

@{
    ViewBag.Title = "HistoricoPedido";
}

<h2>HistoricoPedido @ViewData["Pedido"]</h2>

<p>
    @Html.ActionLink("Voltar", "../home/Index")
</p>
<table class="table" width="800" border="1">
    <tr>
       
        <th width="400">
           Data Ocorrencia
        </th>
        <th width="400">
            Observação
        </th>
        <th ></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DataOcorrencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Obs)
        </td>
       
    </tr>
}

</table>
