@model IEnumerable<Transportadora.Models.Pedidos>

@{
    ViewBag.Title = "EntregarPedidos";
}

<h2>EntregarPedidos</h2>

@Html.ActionLink("Retornar ao Menu", "../home/Index")
<br />
<br />

<table class="table" width="800" border="1">
    <tr>
        <th width="50">
            Codigo
        </th>
        <th width="100">
            @Html.DisplayNameFor(model => model.CPF)
        </th>
        <th width="250">
            Nome do Cliente
        </th>
        <th width="200">
            @Html.DisplayNameFor(model => model.Produto)
        </th>
        <th width="50">
            @Html.DisplayNameFor(model => model.Quantidade)
        </th>
        <th width="50">
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th width="100">
            &nbsp;
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CPF)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NomeCliente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Produto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantidade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.ActionLink("Confirmar Entrega", "MudarStatusEntregue/" + item.Cod.ToString())
            </td>

        </tr>
    }

</table>
