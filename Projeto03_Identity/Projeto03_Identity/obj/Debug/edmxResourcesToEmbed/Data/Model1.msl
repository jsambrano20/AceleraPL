<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="AtividadeIdentityModelStoreContainer" CdmEntityContainer="AtividadeIdentityEntities">
    <EntitySetMapping Name="Cliente">
      <EntityTypeMapping TypeName="AtividadeIdentityModel.Cliente">
        <MappingFragment StoreEntitySet="Cliente">
          <ScalarProperty Name="Idade" ColumnName="Idade" />
          <ScalarProperty Name="Email" ColumnName="Email" />
          <ScalarProperty Name="Nome" ColumnName="Nome" />
          <ScalarProperty Name="ID" ColumnName="ID" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Navegacao">
      <EntityTypeMapping TypeName="AtividadeIdentityModel.Navegacao">
        <MappingFragment StoreEntitySet="Navegacao">
          <ScalarProperty Name="IdAcao" ColumnName="IdAcao" />
          <ScalarProperty Name="Acao" ColumnName="Acao" />
          <ScalarProperty Name="Nome" ColumnName="Nome" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>